{
  "name": "@tacazo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cuentas": {
      "types": "./dist/cuentas.d.ts",
      "default": "./dist/cuentas.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./migrar": {
      "types": "./dist/migrar.d.ts",
      "default": "./dist/migrar.js"
    },
    "./moderacion": {
      "types": "./dist/moderacion.d.ts",
      "default": "./dist/moderacion.js"
    },
    "./monedas": {
      "types": "./dist/monedas.d.ts",
      "default": "./dist/monedas.js"
    },
    "./partidas": {
      "types": "./dist/partidas.d.ts",
      "default": "./dist/partidas.js"
    },
    "./prueba-db": {
      "types": "./dist/prueba-db.d.ts",
      "default": "./dist/prueba-db.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && node --watch dist/index.js",
    "migrar": "tsc -b && node dist/cli-migrar.js",
    "monedas": "tsc -b && node dist/cli-monedas.js",
    "senales": "tsc -b && node dist/cli-senales.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@tacazo/core": "workspace:*",
    "fastify": "5.12.8",
    "jose": "6.2.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/pg": "8.23.1"
  }
}
